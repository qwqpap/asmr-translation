<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ASMR Translation" Manufacturer="ASMR Translation contributors"
           Version="$(var.ProductVersion)" UpgradeCode="{2F8A5B9E-7D4F-4F30-9FA8-1A65A8B6F2C1}"
           Scope="perUser" Compressed="yes">
    <SummaryInformation Description="Local Japanese ASMR transcription and translation" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 ASMR Translation。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ASMR Translation">
          <Directory Id="BOOTSTRAPDIR" Name="bootstrap" />
          <Directory Id="MANIFESTDIR" Name="manifest" />
          <Directory Id="WHEELDIR" Name="wheel" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ASMR Translation" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="ASMR Translation" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ComponentGroup Id="ApplicationFiles">
      <Component Id="ApplicationFilesComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MainExecutable" Source="!(bindpath.stage)\asmr-translation.exe" KeyPath="yes" />
      <File Id="Readme" Source="!(bindpath.stage)\README.md" />
      <File Id="Copying" Source="!(bindpath.stage)\COPYING" />
      <File Id="ThirdParty" Source="!(bindpath.stage)\THIRD_PARTY_NOTICES.md" />
      </Component>
      <Component Id="BootstrapComponent" Directory="BOOTSTRAPDIR" Guid="*">
        <File Id="BootstrapScript" Source="!(bindpath.stage)\bootstrap\bootstrap.ps1" KeyPath="yes" />
      </Component>
      <Component Id="ManifestComponent" Directory="MANIFESTDIR" Guid="*">
        <File Id="ArtifactManifest" Source="!(bindpath.stage)\manifest\artifacts.json" KeyPath="yes" />
      </Component>
      <Component Id="WheelComponent" Directory="WHEELDIR" Guid="*">
        <File Id="ProjectWheel" Source="!(bindpath.stage)\wheel\$(var.ProjectWheelName)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationShortcut" Name="ASMR Translation" Target="[#MainExecutable]"
                WorkingDirectory="INSTALLFOLDER" Description="ASMR Translation" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ASMR Translation" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
