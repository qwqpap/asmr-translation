[Desktop Entry]
Type=Application
# 1.1 is the newest spec revision every shipping desktop-file-validate knows;
# claiming 1.5 makes older validators emit a spurious warning.  Nothing here
# needs a key introduced after 1.1 (Keywords is the newest one used).
Version=1.1
Name=ASMR Translation
Name[zh_CN]=ASMR 翻译
GenericName=Japanese ASMR transcription and translation
GenericName[zh_CN]=日语 ASMR 转写与翻译
Comment=Transcribe Japanese audio locally and generate Simplified Chinese LRC
Comment[zh_CN]=本地转写日语音频并生成简体中文 LRC 字幕
# install.sh rewrites @LAUNCHER@ to the absolute path of the installed
# launcher; the app takes no file arguments, so there is no %F here.
Exec=@LAUNCHER@
Icon=asmr-translation
Terminal=false
Categories=AudioVideo;Audio;Utility;
Keywords=ASMR;transcription;translation;subtitle;LRC;whisper;
# Qt derives WM_CLASS from setDesktopFileName(), so this matches asmr_gui.app.
StartupWMClass=asmr-translation
StartupNotify=true
